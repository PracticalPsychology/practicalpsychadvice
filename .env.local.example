# Private Stripe API key. Match the account and mode of the catalog Price IDs.
STRIPE_SECRET_KEY=sk_test_YOUR_KEY_HERE

# Stripe CLI signing secret for local tests, endpoint signing secret in production.
STRIPE_WEBHOOK_SECRET=whsec_YOUR_KEY_HERE

# Trusted origin for Stripe success and cancellation redirect links.
SITE_URL=http://localhost:3000

# Configure one per book. With no link, the success page directs buyers to support.
# BOOK_DOWNLOAD_URL_BOOK_1=
# BOOK_DOWNLOAD_URL_BOOK_10=
